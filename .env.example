# Copy to .env (never commit it). All values are optional.
# Without a key the app still works using curated, deterministic ideas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_SECONDS=12
RATE_LIMIT_PER_MINUTE=30
MAX_BODY_BYTES=16384
TRUST_PROXY=false
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=256
APP_TIMEZONE=UTC
LOG_LEVEL=INFO
